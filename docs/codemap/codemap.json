  "flows": [
    {
      "id": "public-dashboard",
      "title": "Open the race dashboard",
      "trigger": "GET / or another public RaceSide page",
      "steps": [
        "public-web",
        "auth-account",
        "public-repository",
        "supabase-clients",
        "postgres"
      ],
      "outcome": "A server-rendered page returns cached RaceSide data, session-aware controls, and no direct provider calls."
    },
    {
      "id": "news-publish",
      "title": "Ingest and publish a story",
      "trigger": "rss.fetch_all followed by ai.process_news",
      "steps": [
        "worker-runtime",
        "news-ai",
        "external-content",
        "openrouter",
        "postgres",
        "public-repository",
        "public-web"
      ],
      "outcome": "Normalized, deduplicated, Russian-language news is persisted and becomes readable on public pages."
    },
    {
      "id": "race-data-replay",
      "title": "Sync a race and prepare replay",
      "trigger": "Scheduled Jolpica/OpenF1 sync and race_replay.prepare_current",
      "steps": [
        "worker-runtime",
        "f1-sync",
        "external-f1",
        "race-replay",
        "postgres",
        "public-repository",
        "public-web"
      ],
      "outcome": "Calendar, results, weather, and replay telemetry are cached in Postgres and served by RaceSide."
    },
    {
      "id": "prediction-score",
      "title": "Submit and score a prediction",
      "trigger": "Authenticated prediction form submission, then predictions.score",
      "steps": [
        "fan-actions",
        "auth-account",
        "supabase-clients",
        "postgres",
        "worker-runtime",
        "prediction-scoring"
      ],
      "outcome": "A lock-aware prediction is stored, scored after results arrive, and exposed in fantasy views."
    },
    {
      "id": "admin-queued-sync",
      "title": "Run an admin sync task",
      "trigger": "An admin selects an allowlisted job",
      "steps": [
        "admin-console",
        "auth-account",
        "job-queue",
        "postgres",
        "worker-runtime",
        "f1-sync",
        "external-f1",
        "admin-repository"
      ],
      "outcome": "The request is audited, queued, claimed by the worker, executed, and reflected in operational status."
    }
  ]
